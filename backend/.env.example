# MediDocs AI backend configuration (copy to .env). Never commit .env.
PORT=3000
# Comma-separated list of allowed browser origins (Angular dev server)
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Ollama (local only). 127.0.0.1 is used instead of "localhost" to avoid IPv6 issues on Windows.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# Base names (or full names) the UI may offer for chat. Embedding models are never offered.
ALLOWED_CHAT_MODELS=gemma3,llama3
OLLAMA_EMBED_TIMEOUT_MS=120000
# Keep this below 300000: Node's HTTP client gives up after 5 minutes of silence.
OLLAMA_CHAT_TIMEOUT_MS=240000

# Storage (relative paths are resolved from the backend folder; absolute paths may contain spaces)
DATA_DIR=./data
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=300

# RAG settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MIN_SIMILARITY=0.30
EMBED_BATCH_SIZE=8
CHAT_NUM_CTX=4096

# Rate limits (requests per minute per client)
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_ASK_PER_MINUTE=12
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# Optional: serve the built Angular app from this backend (single-port mode)
FRONTEND_DIST=../frontend/dist/medidocs/browser

LOG_REQUESTS=true
